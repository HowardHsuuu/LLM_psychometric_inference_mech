{"item_id": "pom_01", "item_number": 1, "text": "我的內心是舒服而且自在的。", "text_en": null, "response_options": [1,2,3,4,5,6], "reverse_coded": false, "subscale": "Peace_of_Mind"}
{"item_id": "pom_02", "item_number": 2, "text": "我的內心是輕鬆自在的。", "text_en": null, "response_options": [1,2,3,4,5,6], "reverse_coded": false, "subscale": "Peace_of_Mind"}
{"item_id": "pom_03", "item_number": 3, "text": "在生活中我覺得怡然自得。", "text_en": null, "response_options": [1,2,3,4,5,6], "reverse_coded": false, "subscale": "Peace_of_Mind"}
{"item_id": "pom_04", "item_number": 4, "text": "我的生活給我一種平靜安穩的感覺。", "text_en": null, "response_options": [1,2,3,4,5,6], "reverse_coded": false, "subscale": "Peace_of_Mind"}
{"item_id": "pom_05", "item_number": 5, "text": "要讓自己擁有內心的安定感是很困難的。", "text_en": null, "response_options": [1,2,3,4,5,6], "reverse_coded": true, "subscale": "Peace_of_Mind"}
{"item_id": "pom_06", "item_number": 6, "text": "我擁有內心的平靜與和諧。", "text_en": null, "response_options": [1,2,3,4,5,6], "reverse_coded": false, "subscale": "Peace_of_Mind"}
{"item_id": "pom_07", "item_number": 7, "text": "我的內心感到焦躁不安。", "text_en": null, "response_options": [1,2,3,4,5,6], "reverse_coded": true, "subscale": "Peace_of_Mind"}
