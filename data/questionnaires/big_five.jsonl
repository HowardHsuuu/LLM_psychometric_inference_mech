{"_metadata": true, "scale_id": "big_five", "scale_name": "Big Five Inventory-10 (BFI-10)", "scale_name_zh": "短板大五性格問卷", "n_items": 10, "response_range": [1, 7], "response_labels": ["非常不同意", "不同意", "有點不同意", "無意見", "有點同意", "同意", "非常同意"], "instruction": "下面有一些人格特質的描述，可能符合也可能不符合你。請選出你在多大程度上同意或者不同意這些描述。我認為我自己……", "instruction_en": "How well do the following statements describe your personality? I see myself as someone who...", "reverse_items": [2,6,8,9,10], "subscales": [{"name": "Extraversion", "items": [1,6], "scoring": "mean"}, {"name": "Agreeableness", "items": [2,7], "scoring": "mean"}, {"name": "Conscientiousness", "items": [3,8], "scoring": "mean"}, {"name": "Neuroticism", "items": [4,9], "scoring": "mean"}, {"name": "Openness", "items": [5,10], "scoring": "mean"}]}
{"item_id": "bf_01", "item_number": 1, "text": "外向的，熱情的", "text_en": "is outgoing, sociable", "response_options": [1,2,3,4,5,6,7], "reverse_coded": false, "subscale": "Extraversion"}
{"item_id": "bf_02", "item_number": 2, "text": "批判的，好爭論的", "text_en": "tends to find fault with others", "response_options": [1,2,3,4,5,6,7], "reverse_coded": true, "subscale": "Agreeableness"}
{"item_id": "bf_03", "item_number": 3, "text": "可靠的，自律的", "text_en": "does a thorough job", "response_options": [1,2,3,4,5,6,7], "reverse_coded": false, "subscale": "Conscientiousness"}
{"item_id": "bf_04", "item_number": 4, "text": "焦慮的，容易不安", "text_en": "gets nervous easily", "response_options": [1,2,3,4,5,6,7], "reverse_coded": false, "subscale": "Neuroticism"}
{"item_id": "bf_05", "item_number": 5, "text": "願意接受新的體驗、喜歡複雜的", "text_en": "has an active imagination", "response_options": [1,2,3,4,5,6,7], "reverse_coded": false, "subscale": "Openness"}
{"item_id": "bf_06", "item_number": 6, "text": "保守的，安靜的", "text_en": "is reserved", "response_options": [1,2,3,4,5,6,7], "reverse_coded": true, "subscale": "Extraversion"}
{"item_id": "bf_07", "item_number": 7, "text": "有同情心的，温暖的", "text_en": "is generally trusting", "response_options": [1,2,3,4,5,6,7], "reverse_coded": false, "subscale": "Agreeableness"}
{"item_id": "bf_08", "item_number": 8, "text": "雜亂無章的，粗心大意的", "text_en": "tends to be lazy", "response_options": [1,2,3,4,5,6,7], "reverse_coded": true, "subscale": "Conscientiousness"}
{"item_id": "bf_09", "item_number": 9, "text": "平靜的，情緒穩定的", "text_en": "is relaxed, handles stress well", "response_options": [1,2,3,4,5,6,7], "reverse_coded": true, "subscale": "Neuroticism"}
{"item_id": "bf_10", "item_number": 10, "text": "傳統的，無創造性的", "text_en": "has few artistic interests", "response_options": [1,2,3,4,5,6,7], "reverse_coded": true, "subscale": "Openness"}
